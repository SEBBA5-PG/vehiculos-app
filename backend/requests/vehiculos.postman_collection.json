  },
  "item": [
    {
      "name": "TC-VEH-01 · Crear vehículo válido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base}}/vehiculos",
          "host": [
            "{{base}}"
          ],
          "path": [
            "vehiculos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"placa\": \"{{placa}}\",\n  \"marca\": \"Toyota\",\n  \"modelo\": \"Corolla\",\n  \"anio\": 2024,\n  \"color\": \"Blanco\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('TC-VEH-01 · Crear vehículo válido → HTTP 201', () => pm.response.to.have.status(201));",
              "const b = pm.response.json(); pm.collectionVariables.set('id', b.id);\npm.test('id serializado como string', () => pm.expect(b.id).to.be.a('string'));"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Placa única por ejecución (máx. 10 caracteres) para poder repetir la colección",
              "pm.collectionVariables.set('placa', 'PM' + Date.now().toString().slice(-6));"
            ]
          }
        }
      ]
    },
